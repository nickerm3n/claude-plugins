{
  "description": "Railguards: blocks git push and gh pr create until the exact diff has been through the gate",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.sh\" hook"
          }
        ]
      }
    ]
  }
}
